# Application Configuration
PORT=5000
NODE_ENV=development

# Neon Database Connection String (Serverless PostgreSQL)
# Replace with your actual Neon connection string:
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Configuration
CLIENT_ORIGIN=http://localhost:3000

# JWT Secrets (if using JWT auth)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
